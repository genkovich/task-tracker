# /opt/task-tracker/.env на VPS. Секрети живуть тільки тут — не в репо.
DOMAIN=task-tracker.example.com
# battery:observability
GRAFANA_DOMAIN=grafana.task-tracker.example.com
# /battery:observability
IMAGE_TAG=latest

POSTGRES_USER=task-tracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=task-tracker
DATABASE_URL=postgres://task-tracker:change-me@postgres:5432/task-tracker?sslmode=disable

JWT_SECRET=change-me
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

# battery:observability
GRAFANA_ADMIN_PASSWORD=change-me
# /battery:observability
