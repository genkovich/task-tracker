# {$DOMAIN} — основний застосунок; домени приходять з .env на VPS.
# battery:observability
# {$GRAFANA_DOMAIN} — Grafana з метриками.
# /battery:observability

{$DOMAIN} {
	# Стискаємо лише перелічені типи. Дефолтний match у encode покриває text/*,
	# куди підпадає і text/event-stream — а стиснутий SSE-стрім Caddy буферизує
	# цілком, і жоден flush_interval це не рятує: клієнт не бачить ані байта.
	# Доведено живим прогоном 2026-08-21 (api віддає keepalive, з encode — тиша).
	encode zstd gzip {
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/plain*
			header Content-Type text/javascript*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/xml*
			header Content-Type image/svg+xml*
		}
	}

	handle /api/* {
		# SSE (sad.md §7, ADR-0002): стрім не можна буферизувати. flush_interval -1
		# (негайний flush) стоїть на всьому api-proxy, а не окремих SSE-шляхах:
		# звичайним JSON-відповідям миттєвий flush нічого не коштує, а конфіг
		# лишається одним блоком без дублювання reverse_proxy.
		reverse_proxy api:8080 {
			flush_interval -1
		}
	}
	# Health-и наживо з домену — по /readyz гейтиться деплой.
	handle /livez {
		reverse_proxy api:8080
	}
	handle /readyz {
		reverse_proxy api:8080
	}
	# Локальне файлове сховище (аватари) віддає API.
	handle /files/* {
		reverse_proxy api:8080
	}
	# battery:web
	handle {
		# Публічна дошка /b/{token} — capability URL: API вже шле
		# X-Robots-Tag на /api/v1/public/*, але краулер, що отримав лінк,
		# ходить саме на SPA-шлях /b/* — його теж не можна індексувати.
		@publicBoard path /b/*
		header @publicBoard X-Robots-Tag "noindex, nofollow"
		reverse_proxy web:80
	}
	# /battery:web
}

# battery:observability
{$GRAFANA_DOMAIN} {
	reverse_proxy grafana:3000
}
# /battery:observability
