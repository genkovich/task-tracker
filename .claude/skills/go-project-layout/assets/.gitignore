# beer-lms-api .gitignore — copy to the Go module root (beer-lms-api/.gitignore).
# Mirrors the real file in this repo. The repo ROOT additionally ignores .claude/
# and local run scratch — keep those in the root .gitignore, not here.

# Binaries
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary
*.test

# Output of go coverage
*.out
coverage.html

# Environment
.env
.env.local

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Vendor (using modules)
vendor/

# Temporary files
tmp/
