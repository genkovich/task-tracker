# Env застосунку. Скопіюй у api/.env (gitignored): його читає і локальний
# дев-цикл (`make -C api run`), і docker compose (env_file). За потреби заповни
# реальні GOOGLE_* — без них стек живий, але логін не пройде.

# Application
PORT=8080
APP_ENV=development
LOG_LEVEL=info

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database — localhost для локального дев-циклу; всередині compose api/migrate
# отримують override з хостом postgres (див. docker-compose.yml)
DATABASE_URL=postgres://task-tracker:task-tracker@localhost:5432/task-tracker?sslmode=disable

# Auth (dev placeholders)
JWT_SECRET=dev-secret-change-me
GOOGLE_CLIENT_ID=dummy-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dummy-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Avatar storage (S3-compatible, e.g. Contabo Object Storage).
# If AVATAR_S3_BUCKET is empty, the API falls back to local /var/www/files/avatars.
AVATAR_S3_BUCKET=
AVATAR_S3_REGION=
AVATAR_S3_ENDPOINT=
AVATAR_S3_PUBLIC_BASE_URL=
AVATAR_S3_ACCESS_KEY_ID=
AVATAR_S3_SECRET_ACCESS_KEY=
